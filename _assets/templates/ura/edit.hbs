<div class="editor-container">
  <div class="editor-wrapper">
    <input class="editor-title" type="text" name="title" id="title" placeholder="タイトル" {{#if title}}value="{{title}}"{{/if}} />
    <div class="editor-bar">
      <input class="editor-date" type="text" name="date" id="date" placeholder="2112/09/03 15:33:44" {{#if date}}value="{{date}}"{{/if}} />
      <select name="author" id="author">
        <option value="宵宮ナギ" {{#if (eq author "宵宮ナギ")}}selected{{/if}}>宵宮ナギ</option>
        <option value="甚三紅もみじ" {{#if (eq author "甚三紅もみじ")}}selected{{/if}}>甚三紅もみじ</option>
      </select>
      <select name="status" id="status">
        <option value="draft" {{#if (eq status "draft")}}selected{{/if}}>下書き</option>
        <option value="published" {{#if (eq status "published")}}selected{{/if}}>公開</option>
      </select>
      <div class="space"></div>
      <button id="upload">&nbsp;⬆&nbsp;</button>
      <div class="space"></div>
      <button id="save">SAVE</button>
      <div style="width: 1em;"></div>
      <button id="delete">DEL</button>
    </div>
    <div class="editor-bar editor-curation">
      <select name="tier" id="tier" title="tier">
        <option value="pickup" {{#if (eq tier "pickup")}}selected{{/if}}>pickup</option>
        <option value="archive" {{#if (eq tier "archive")}}selected{{/if}}>archive</option>
        <option value="sketch" {{#if (eq tier "sketch")}}selected{{/if}}>sketch</option>
        <option value="hidden" {{#if (eq tier "hidden")}}selected{{/if}}>hidden</option>
      </select>
      <input class="editor-series" type="text" name="series" id="series" title="series" placeholder="series（カンマ区切り）" {{#if series}}value="{{series}}"{{/if}} />
      <select name="sensitive" id="sensitive" title="sensitive">
        <option value="auto" {{#if (eq sensitive "auto")}}selected{{/if}}>自動（今は {{#if autoSensitive}}はい{{else}}いいえ{{/if}}）</option>
        <option value="true" {{#if (eq sensitive "true")}}selected{{/if}}>上書き：はい</option>
        <option value="false" {{#if (eq sensitive "false")}}selected{{/if}}>上書き：いいえ</option>
      </select>
    </div>
    <textarea id="text">{{text}}</textarea>
  </div>
  <div id="preview"></div>
</div>
<script src="/js/editor.js"></script>
