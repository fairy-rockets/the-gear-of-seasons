{
  "name": "server",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "init": "tsc --init",
    "start": "ts-node --esm src/cmd/main.ts",
    "watch": "ts-node-dev --esm src/cmd/main.ts",
    "build": "tsc",
    "clean": "rm -Rf ./dist",
    "up": "npm-check-updates -u && npm install && npm dedupe && npm audit fix",
    "test": "mocha"
  },
  "exports": {
    ".": {
      "types": "./dist/cmd/main.d.ts",
      "import": "./dist/cmd/main.js"
    },
    "./protocol": {
      "types": "./dist/lib/protocol.d.ts",
      "import": "./dist/lib/protocol.js"
    }
  },
  "types": "./dist/cmd/main.d.ts",
  "main": "./dist/cmd/main.js",
  "author": "Kaede Fujisaki",
  "license": "AGPL-3.0-or-later",
  "devDependencies": {
    "@types/marked": "^6.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20",
    "mocha": "^11.7.5",
    "npm-check-updates": "^22.2.0",
    "ts-node-dev": "^2.0.0"
  },
  "dependencies": {
    "@expo/spawn-async": "^1.7.2",
    "@fastify/send": "^4.1.0",
    "@fastify/static": "^10.1.2",
    "@wordpress/escape-html": "^3.46.0",
    "axios": "^1.16.1",
    "dayjs": "^1.11.20",
    "exifr": "^7.1.3",
    "fastify": "^5.8.5",
    "file-type": "^22.0.1",
    "generic-pool": "^3.9.0",
    "handlebars": "^4.7.9",
    "marked": "^18.0.3",
    "node-cache": "^5.1.2",
    "pino": "^10.3.1",
    "ts-node": "^10.9.2",
    "ts-postgres": "^2.0.4",
    "typescript": "^6.0.3"
  }
}
