{
  "name": "server",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "init": "tsc --init",
    "start": "ts-node --esm src/cmd/main.ts",
    "watch": "ts-node-dev --esm src/cmd/main.ts",
    "build": "tsc",
    "clean": "rm -Rf ./dist",
    "up": "npm-check-updates -u && npm install && npm dedupe && npm audit fix",
    "test": "mocha"
  },
  "exports": {
    ".": {
      "types": "./dist/cmd/main.d.ts",
      "import": "./dist/cmd/main.js"
    },
    "./protocol": {
      "types": "./dist/lib/protocol.d.ts",
      "import": "./dist/lib/protocol.js"
    }
  },
  "types": "./dist/cmd/main.d.ts",
  "main": "./dist/cmd/main.js",
  "author": "Kaede Fujisaki",
  "license": "AGPL-3.0-or-later",
  "devDependencies": {
    "@types/generic-pool": "^3.8.3",
    "@types/marked": "^6.0.0",
    "@types/mocha": "^10.0.9",
    "@types/node": "^20",
    "mocha": "^10.8.2",
    "npm-check-updates": "^17.1.10",
    "ts-node-dev": "^2.0.0"
  },
  "dependencies": {
    "@expo/spawn-async": "^1.7.2",
    "@fastify/static": "^8.0.2",
    "@wordpress/escape-html": "^3.11.0",
    "axios": "^1.7.7",
    "dayjs": "^1.11.13",
    "exifr": "^7.1.3",
    "fastify": "^5.1.0",
    "file-type": "^19.6.0",
    "generic-pool": "^3.9.0",
    "handlebars": "^4.7.8",
    "marked": "^15.0.0",
    "node-cache": "^5.1.2",
    "pino": "^9.5.0",
    "ts-node": "^10.9.2",
    "ts-postgres": "^2.0.4",
    "typescript": "^5.6.3"
  }
}
